#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:406
msgid "Choose default audio devices."
msgstr "اختيار أجهزة الصوت الافتراضية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:427
msgid "Set speaker 1 as default."
msgstr "تعيين السماعة الأولى كافتراضية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:434
msgid "Set speaker 2 as default."
msgstr "تعيين السماعة الثانية كافتراضية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:441
msgid "Set speaker 3 as default."
msgstr "تعيين السماعة الثالثة كافتراضية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:448
msgid "Set microphone 1 as default."
msgstr "تعيين الميكروفون الأول كافتراضي."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:455
msgid "Set microphone 2 as default."
msgstr "تعيين الميكروفون الثاني كافتراضي."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:462
msgid "Set microphone 3 as default."
msgstr "تعيين الميكروفون الثالث كافتراضي."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:469
msgid "Announce current default speaker."
msgstr "نطق السماعة الافتراضية الحالية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:476
msgid "Announce current default microphone."
msgstr "نطق الميكروفون الافتراضي الحالي."

#: buildVars.py:24
msgid ""
"Sets configured or directly selected speakers and microphones as default and "
"announces current defaults."
msgstr ""
"تعيين السماعات والميكروفونات المهيأة أو المختارة مباشرة أجهزة افتراضية، ونطق "
"الأجهزة الافتراضية الحالية."

#: buildVars.py:32
msgid ""
"Added a quick dialog for independently selecting the default speaker and "
"microphone, and limited device lists to connected devices."
msgstr ""
"إضافة حوار سريع لاختيار السماعة والميكروفون الافتراضيين على استقلال، وقصر "
"قوائم الأجهزة على المتصل منها."
