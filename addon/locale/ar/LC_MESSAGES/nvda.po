#: addon\globalPlugins\audio_switcher\__init__.py:89
msgid "speaker"
msgstr "السماعة"

#: addon\globalPlugins\audio_switcher\__init__.py:92
msgid "mic"
msgstr "الميكروفون"

#. Translators: short message when the requested device slot is empty.
#: addon\globalPlugins\audio_switcher\__init__.py:98
msgid "Not set"
msgstr "غير مهيأ"

#. Translators: short message when the configured device is unavailable.
#: addon\globalPlugins\audio_switcher\__init__.py:133
msgid "Not found"
msgstr "تعذر العثور على الجهاز"

#. Translators: short message when a default audio device slot is selected.
#: addon\globalPlugins\audio_switcher\__init__.py:154
#, python-brace-format
msgid "Done: {deviceType} {slot}"
msgstr "تم تعيين: {deviceType} {slot}"

#. Translators: short message when setting default device fails.
#: addon\globalPlugins\audio_switcher\__init__.py:157
msgid "Failed to set device"
msgstr "تعذر تفعيل الجهاز"

#. Translators: short message announcing the current default speaker.
#: addon\globalPlugins\audio_switcher\__init__.py:165
#, python-brace-format
msgid "Speaker: {device}"
msgstr "السماعة: {device}"

#. Translators: short message when there is no default speaker.
#: addon\globalPlugins\audio_switcher\__init__.py:168
msgid "No speaker"
msgstr "لا توجد سماعة"

#. Translators: short message announcing the current default microphone.
#: addon\globalPlugins\audio_switcher\__init__.py:172
#, python-brace-format
msgid "Mic: {device}"
msgstr "الميكروفون: {device}"

#. Translators: short message when there is no default microphone.
#: addon\globalPlugins\audio_switcher\__init__.py:175
msgid "No mic"
msgstr "لا يوجد ميكروفون"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\audio_switcher\__init__.py:179
#: addon\globalPlugins\audio_switcher\__init__.py:313 buildVars.py:20
msgid "Audio Switcher"
msgstr "مبدل أجهزة الصوت"

#. Translators: suffix shown next to a saved device that is not currently connected.
#: addon\globalPlugins\audio_switcher\__init__.py:212
msgid "(disconnected)"
msgstr "(غير متصل)"

#: addon\globalPlugins\audio_switcher\__init__.py:234
msgid "&Speaker 1:"
msgstr "&السماعة الأولى:"

#: addon\globalPlugins\audio_switcher\__init__.py:242
msgid "S&peaker 2:"
msgstr "ا&لسماعة الثانية:"

#: addon\globalPlugins\audio_switcher\__init__.py:250
msgid "Sp&eaker 3:"
msgstr "الس&ماعة الثالثة:"

#: addon\globalPlugins\audio_switcher\__init__.py:258
msgid "&Microphone 1:"
msgstr "&الميكروفون الأول:"

#: addon\globalPlugins\audio_switcher\__init__.py:266
msgid "M&icrophone 2:"
msgstr "ا&لميكروفون الثاني:"

#: addon\globalPlugins\audio_switcher\__init__.py:274
msgid "Mi&crophone 3:"
msgstr "الم&يكروفون الثالث:"

#: addon\globalPlugins\audio_switcher\__init__.py:282
msgid "Beep and Speech"
msgstr "صافرة ونطق"

#: addon\globalPlugins\audio_switcher\__init__.py:283
msgid "Speech Only"
msgstr "نطق فقط"

#: addon\globalPlugins\audio_switcher\__init__.py:284
msgid "Beep Only"
msgstr "صافرة فقط"

#: addon\globalPlugins\audio_switcher\__init__.py:285
msgid "None"
msgstr "بلا"

#: addon\globalPlugins\audio_switcher\__init__.py:288
msgid "Feedback &Type:"
msgstr "&أسلوب التنبيه:"

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:329
msgid "Set speaker 1 as default."
msgstr "تعيين السماعة الأولى كافتراضية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:336
msgid "Set speaker 2 as default."
msgstr "تعيين السماعة الثانية كافتراضية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:343
msgid "Set speaker 3 as default."
msgstr "تعيين السماعة الثالثة كافتراضية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:350
msgid "Set microphone 1 as default."
msgstr "تعيين الميكروفون الأول كافتراضي."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:357
msgid "Set microphone 2 as default."
msgstr "تعيين الميكروفون الثاني كافتراضي."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:364
msgid "Set microphone 3 as default."
msgstr "تعيين الميكروفون الثالث كافتراضي."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:371
msgid "Announce current default speaker."
msgstr "نطق السماعة الافتراضية الحالية."

#. Translators: description in Input Gestures dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:378
msgid "Announce current default microphone."
msgstr "نطق الميكروفون الافتراضي الحالي."

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Sets one of three configured speakers or microphones as default and announces current defaults."
msgstr "تعيين إحدى السماعات أو الميكروفونات الثلاثة المهيأة كجهاز افتراضي ونطق الأجهزة الافتراضية الحالية."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:28
msgid ""
"Initial conversion to standard add-on structure, hardware ID matching, and "
"comtypes cache fix."
msgstr "التحويل الأولي لبنية الإضافة القياسية، ومطابقة معرف العتاد الفريد، وإصلاح كاش comtypes."
