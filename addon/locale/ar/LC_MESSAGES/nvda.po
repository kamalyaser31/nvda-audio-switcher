#: addon\globalPlugins\audio_switcher\__init__.py:134
msgid "speaker"
msgstr "السماعة"

#: addon\globalPlugins\audio_switcher\__init__.py:137
msgid "mic"
msgstr "الميكروفون"

#. Translators: short message when the requested device slot is empty.
#: addon\globalPlugins\audio_switcher\__init__.py:143
msgid "Not set"
msgstr "غير مهيأ"

#. Translators: short message when the configured device is unavailable.
#: addon\globalPlugins\audio_switcher\__init__.py:153
msgid "Not found"
msgstr "تعذر العثور على الجهاز"

#. Translators: short message when a default audio device slot is selected.
#: addon\globalPlugins\audio_switcher\__init__.py:158
#, python-brace-format
msgid "Done: {deviceType} {slot}"
msgstr "تم تعيين: {deviceType} {slot}"

#. Translators: short message when setting default device fails.
#: addon\globalPlugins\audio_switcher\__init__.py:165
msgid "Failed to set device"
msgstr "تعذر تفعيل الجهاز"

#. Translators: short message announcing the current default speaker.
#: addon\globalPlugins\audio_switcher\__init__.py:173
#, python-brace-format
msgid "Speaker: {device}"
msgstr "السماعة: {device}"

#. Translators: short message when there is no default speaker.
#: addon\globalPlugins\audio_switcher\__init__.py:176
msgid "No speaker"
msgstr "لا توجد سماعة"

#. Translators: short message announcing the current default microphone.
#: addon\globalPlugins\audio_switcher\__init__.py:180
#, python-brace-format
msgid "Mic: {device}"
msgstr "الميكروفون: {device}"

#. Translators: short message when there is no default microphone.
#: addon\globalPlugins\audio_switcher\__init__.py:183
msgid "No mic"
msgstr "لا يوجد ميكروفون"

#. Translators: confirms a speaker selected in the quick dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:193
#, python-brace-format
msgid "Default speaker: {device}"
msgstr "السماعة الافتراضية: {device}"

#: addon\globalPlugins\audio_switcher\__init__.py:195
msgid "Failed to set speaker"
msgstr "تعذر تعيين السماعة"

#. Translators: confirms a microphone selected in the quick dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:200
#, python-brace-format
msgid "Default microphone: {device}"
msgstr "الميكروفون الافتراضي: {device}"

#: addon\globalPlugins\audio_switcher\__init__.py:203
msgid "Failed to set microphone"
msgstr "تعذر تعيين الميكروفون"

#: addon\globalPlugins\audio_switcher\__init__.py:211
msgid "Choose default audio devices"
msgstr "اختيار أجهزة الصوت الافتراضية"

#: addon\globalPlugins\audio_switcher\__init__.py:223
msgid "&Speakers:"
msgstr "ال&سماعات:"

#: addon\globalPlugins\audio_switcher\__init__.py:228
msgid "Do not change the default speaker"
msgstr "لا تغيّر السماعة الافتراضية"

#: addon\globalPlugins\audio_switcher\__init__.py:234
msgid "&Microphones:"
msgstr "ال&ميكروفونات:"

#: addon\globalPlugins\audio_switcher\__init__.py:239
msgid "Do not change the default microphone"
msgstr "لا تغيّر الميكروفون الافتراضي"

#: addon\globalPlugins\audio_switcher\__init__.py:245
msgid "&Apply"
msgstr "&تطبيق"

#. Translators: marks the current device in the quick selection dialog.
#: addon\globalPlugins\audio_switcher\__init__.py:262
#, python-brace-format
msgid "{device} (current default)"
msgstr "{device} (الافتراضي حالياً)"

